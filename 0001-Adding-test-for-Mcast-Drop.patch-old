--- a/src/python/oftest/testutils.py
+++ b/src/python/oftest/testutils.py
@@ -66,6 +66,23 @@ def delete_all_flows(ctrl, send_barrier=True):
         do_barrier(ctrl)
     return 0 # for backwards compatibility
 
+def delete_all_flows_one_table(ctrl, table_id=0):
+    """
+    Delete all flows on a table
+    @param ctrl The controller object for the test
+    @param logger Logging object
+    @param table_id Table ID
+    """
+    logging.info("Deleting all flows on table ID: " + str(table_id))
+    msg = ofp.message.flow_delete()
+    msg.out_port = ofp.OFPP_ANY
+    msg.out_group = ofp.OFPG_ANY
+    msg.buffer_id = 0xffffffff
+    msg.table_id = table_id
+    logging.debug(msg.show())
+
+    return ctrl.message_send(msg)
+
